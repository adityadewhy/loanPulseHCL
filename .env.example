# Django
SECRET_KEY=generate-a-unique-secret-with-openssl-rand-hex-32
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# PostgreSQL (replace with your Neon or other PostgreSQL URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_CONN_MAX_AGE=60
DISABLE_SERVER_SIDE_CURSORS=true

# Boss administrator; create or update this account with manage.py create_admin
BOSS_EMAIL=boss@example.com
BOSS_PASSWORD=replace-with-a-unique-password-at-least-12-characters
BOSS_NAME=LoanPulse Boss

# Optional AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
LTI_REVIEW_THRESHOLD=0.40
LTI_REJECTION_THRESHOLD=0.60

# Public HTTPS deployment settings
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=0
TRUST_PROXY=false
